# State files contain sensitive infrastructure details (AWS account ID, IPs, ARNs)
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Downloaded provider plugins and their lock file (versions are bounded in main.tf)
.terraform/
.terraform.lock.hcl

# Sensitive variable files
*.tfvars
*.tfvars.json

# Local cache and generated files (client-setup.sh contains a password)
.rustdesk/
.env
out/
